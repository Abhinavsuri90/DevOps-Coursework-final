# Copy to terraform.tfvars and adjust. Credentials are NOT set here: Terraform reads them
# from `aws configure` (~/.aws/credentials) or environment variables.
aws_region         = "ap-southeast-2"
cluster_name       = "spendwise-eks"
node_instance_type = "t3.small"
node_desired_size  = 1
api_allowed_cidrs  = ["203.0.113.10/32"] # your public IP: curl -s https://checkip.amazonaws.com
